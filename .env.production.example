# Ramp on a VPS. Copy to .env beside compose.yaml, fill it in, chmod 600.
# Nothing here is read in development; .env.local still serves that.

# --- Where it runs -----------------------------------------------------
RAMP_DOMAIN=ramp.example.com
RAMP_PUBLIC_URL=https://ramp.example.com
CORRIDOR_NETWORK=mainnet
RAMP_ASSET=USDC

# --- Database ----------------------------------------------------------
# compose builds DATABASE_URL from these; set a long random password.
POSTGRES_USER=corridor
POSTGRES_PASSWORD=
POSTGRES_DB=corridor

# --- The sponsor key ---------------------------------------------------
# Ramp sponsors each user's account reserve, trustline and fee, so this key
# spends. Preferred: a holder that never gives the secret to the box.
CORRIDOR_SIGNER=turnkey
TURNKEY_ORGANIZATION_ID=
TURNKEY_API_PRIVATE_KEY=
RAMP_SPONSOR_TURNKEY_SIGN_WITH=
# The alternative is the secret in this file. Corridor refuses to invent one
# on mainnet, so a missing value stops the container rather than running with
# a fresh, empty account.
# RAMP_SPONSOR_STELLAR_SECRET=

# --- Access ------------------------------------------------------------
# Self-serve signup is testnet-only. On mainnet an app is created with this.
RAMP_ADMIN_TOKEN=
RAMP_RATE_LIMIT=600
# Keys the customer tag inside each reference, so a public memo never
# identifies a customer. Set it once and keep it: changing it changes tags.
CORRIDOR_TAG_SECRET=

# --- The anchor --------------------------------------------------------
# Unset means the built-in mock, which is for development only.
CORRIDOR_ANCHOR_BASE_URL=
CORRIDOR_PAYOUT_CURRENCY=KES
CORRIDOR_SEP12_SENDER_ID=
CORRIDOR_SEP12_RECEIVER_ID=

# --- Stellar -----------------------------------------------------------
# Horizon: the public one works; a private instance is steadier under load.
CORRIDOR_HORIZON_URL=
# Soroban RPC has no public mainnet endpoint, so mainnet needs one of its own.
CORRIDOR_SOROBAN_RPC_URL=
# Only for an issuer not already in the registry, or to override one.
# CORRIDOR_STELLAR_ISSUER_USDC_MAINNET=
