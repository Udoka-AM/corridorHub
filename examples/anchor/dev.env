# Anchor Platform configuration for a local, testnet-only receiving anchor.
# Copied from the Anchor Platform's quick-run defaults, with the SEPs Corridor
# uses turned on and the ones it does not left off.

STELLAR_NETWORK_TYPE=rpc
STELLAR_NETWORK_RPC_URL=https://soroban-testnet.stellar.org

# Development secrets. Fine here because nothing in this stack is reachable
# from outside the machine and every account is a testnet account.
SECRET_DATA_USERNAME=postgres
SECRET_DATA_PASSWORD=password
SECRET_SEP10_JWT_SECRET=secret_sep10_secret_secret_sep10_secret
SECRET_SEP6_MORE_INFO_URL_JWT_SECRET=secret_sep6_more_info_url_jwt_secret
SECRET_SEP24_INTERACTIVE_URL_JWT_SECRET=secret_sep24_interactive_url_jwt_secret
SECRET_SEP24_MORE_INFO_URL_JWT_SECRET=secret_sep24_more_info_url_jwt_secret
SECRET_SEP45_JWT_SECRET=secret_sep45_secret_secret_sep45_secret

APP_LOGGING_STELLAR_LEVEL=INFO
APP_LOGGING_REQUEST_LOGGER_ENABLED=true
LANGUAGES=en

EVENTS_ENABLED=true
EVENTS_QUEUE_TYPE=kafka
EVENTS_QUEUE_KAFKA_BOOTSTRAP_SERVER=kafka:29092
EVENT_PROCESSOR_CALLBACK_API_REQUEST_ENABLED=true

CALLBACK_API_BASE_URL=http://reference-server:8091/
PLATFORM_API_BASE_URL=http://platform:8085

DATA_TYPE=postgres
DATA_SERVER=db:5432
DATA_DATABASE=postgres
DATA_SCHEMA=anchor-platform
DATA_FLYWAY_ENABLED=true

ASSETS_TYPE=file
ASSETS_VALUE=/config/assets.yaml

# The SEPs Corridor speaks to a receiving anchor.
SEP1_ENABLED=true
SEP1_TOML_TYPE=file
SEP1_TOML_VALUE=/config/stellar.localhost.toml
SEP10_ENABLED=true
# SEP10_WEB_AUTH_DOMAIN and SEP10_HOME_DOMAINS follow the host port, so
# they are set in docker-compose.yaml from ANCHOR_SEP_PORT.
SEP12_ENABLED=true
SEP31_ENABLED=true
SEP38_ENABLED=true

# Not used by a sending anchor: SEP-6 and SEP-24 are deposit and withdrawal
# flows for end users, and SEP-45 is contract authentication.
SEP6_ENABLED=false
SEP24_ENABLED=false
SEP45_ENABLED=false
