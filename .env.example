# Copy to .env.local (gitignored). `pnpm stellar:wallets` generates the
# testnet keys for you and funds them from Friendbot.
CORRIDOR_TAG_SECRET=

# Vault keys. Stellar secrets (S…) for development and testnet; a deployment
# sets CORRIDOR_SIGNER=turnkey or aws-kms instead and never holds these.
TREASURY_STELLAR_SECRET=
ESCROW_STELLAR_SECRET=

# testnet (default) or mainnet
CORRIDOR_NETWORK=testnet
# Optional: a private Horizon instance instead of the public one.
CORRIDOR_HORIZON_URL=
# Soroban RPC, for contract events and the CCTP mint. Required on mainnet:
# there is no public SDF endpoint.
CORRIDOR_SOROBAN_RPC_URL=

# Asset issuers, where one is not set in STELLAR_ISSUERS. Verify each against
# the issuer's own published stellar.toml before using it on mainnet.
CORRIDOR_STELLAR_ISSUER_USDC_MAINNET=
CORRIDOR_STELLAR_ISSUER_MGUSD_MAINNET=

# Read-only mode: accounts to watch, comma-separated.
CORRIDOR_WATCH=

# Cross-chain spokes (CCTP inflows, and partners that settle off Stellar)
BASE_MAINNET_RELAY_KEY=
SOLANA_MAINNET_VAULT_KEYPAIR=.keys/solana-mainnet-vault.json
PAJ_API_KEY=

# The MCP server (pnpm ramp:mcp): an agent key, and where the Ramp API lives.
RAMP_API_KEY=
RAMP_API_URL=
