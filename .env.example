# Copy to .env.local (gitignored). `pnpm tempo:smoke` generates the testnet keys for you.
CORRIDOR_REF_SECRET=
TEMPO_TESTNET_CUSTOMER_KEY=
TEMPO_TESTNET_VAULT_KEY=

# Mainnet micro-funds for the live Across bridge demo (D3). `pnpm mainnet:wallets` creates these and prints what to fund.
TEMPO_MAINNET_VAULT_KEY=
BASE_MAINNET_RELAY_KEY=
SOLANA_MAINNET_VAULT_KEYPAIR=.keys/solana-mainnet-vault.json

# Ramp partner (D4)
PAJ_API_KEY=
