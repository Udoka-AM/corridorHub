{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "maple",
  "name": "Corridor",
  "description": "The settlement hub for money moving into and out of Africa: stablecoin treasury on Tempo, payouts across four regions, and private supplier payments on Zcash.",
